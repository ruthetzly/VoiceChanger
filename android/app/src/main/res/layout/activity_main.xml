<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:padding="16dp">

    <TextView android:id="@+id/tv_title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="🐉 大龙变声翻译器 v2"
        android:textColor="#e94560" android:textSize="22sp" android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="离线识别 → 翻译印尼语 → 女声输出"
        android:textColor="#aaa" android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"/>

    <TextView android:id="@+id/tv_status"
        android:layout_width="0dp" android:layout_height="36dp"
        android:layout_marginTop="12dp" android:gravity="center"
        android:text="启动中..." android:textColor="#0f0" android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle"/>

    <ProgressBar android:id="@+id/progress_bar"
        android:layout_width="0dp" android:layout_height="6dp"
        android:layout_marginTop="4dp" android:visibility="gone"
        style="?android:attr/progressBarStyleHorizontal"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_status"/>

    <ToggleButton android:id="@+id/btn_record"
        android:layout_width="140dp" android:layout_height="140dp"
        android:layout_marginTop="12dp" android:background="@drawable/record_button"
        android:textOff="🎤 开始" android:textOn="⏹ 停止"
        android:textColor="#fff" android:textSize="16sp"
        android:enabled="false"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_bar"/>

    <TextView android:id="@+id/tv_recognized"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:background="#16213e"
        android:gravity="center" android:minHeight="36dp" android:padding="6dp"
        android:text="" android:textColor="#fff" android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_record"/>

    <TextView android:id="@+id/tv_translated"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:background="#16213e"
        android:gravity="center" android:minHeight="36dp" android:padding="6dp"
        android:text="" android:textColor="#4fc3f7" android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_recognized"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="音量" android:textColor="#aaa"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_translated"/>

    <SeekBar android:id="@+id/seek_volume"
        android:layout_width="0dp" android:layout_height="28dp"
        android:max="100" android:progress="80"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_translated"
        android:layout_marginTop="20dp"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_speaker"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="扬声器模式（配合Chatous）"
        android:textColor="#aaa" android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/seek_volume"/>

    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:padding="4dp"
        android:text="💡 首次使用会自动下载语音模型(约40MB)\n说中文 → 自动翻译印尼语 → 女声播放\n开启扬声器模式后打开Chatous即可使用"
        android:textColor="#666" android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switch_speaker"/>
</androidx.constraintlayout.widget.ConstraintLayout>
